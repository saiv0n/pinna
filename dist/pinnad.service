[Unit]
Description=Pinna AirPods service
After=bluetooth.target pipewire.service
PartOf=graphical-session.target

[Service]
ExecStart=@bindir@/pinnad
Restart=on-failure
RestartSec=3
Environment=RUST_LOG=info
Environment="PINNA_POPUP=@bindir@/pinna --popup"

# may only write its config and battery history
ConfigurationDirectory=pinna
ConfigurationDirectoryMode=0700
StateDirectory=pinna
StateDirectoryMode=0700
# fifo of the virtual mic; must survive while the PipeWire module is loaded
RuntimeDirectory=pinna
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
ProtectSystem=strict
ProtectHome=read-only
# the one exception, for the call setting
ReadWritePaths=-%h/.config/wireplumber/wireplumber.conf.d
PrivateTmp=yes
NoNewPrivileges=yes
RestrictSUIDSGID=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictNamespaces=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
# enough for D-Bus, PipeWire and L2CAP
RestrictAddressFamilies=AF_UNIX AF_BLUETOOTH

[Install]
WantedBy=graphical-session.target
