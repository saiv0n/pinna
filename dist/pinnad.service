[Unit]
Description=Pinna AirPods servisi
After=bluetooth.target pipewire.service
PartOf=graphical-session.target

[Service]
ExecStart=%h/.local/bin/pinnad
Restart=on-failure
RestartSec=3
Environment=RUST_LOG=info
Environment="PINNA_POPUP=%h/.local/bin/pinna --popup"

[Install]
WantedBy=graphical-session.target
