# Maintainer: saivon <https://github.com/saiv0n>
pkgname=pinna-git
pkgver=0.1.0.r0.g0000000
pkgrel=1
pkgdesc='AirPods manager: battery, noise control, ear detection and settings'
arch=(x86_64 aarch64)
url='https://github.com/saiv0n/pinna'
license=(GPL-3.0-or-later)
depends=(bluez dbus ffmpeg gcc-libs glibc hicolor-icon-theme libpulse pipewire
         qt6-base qt6-declarative qt6-svg wireplumber)
makedepends=(cargo cmake git ninja qt6-tools)
optdepends=('libmysofa: spatial audio')
provides=(pinna)
conflicts=(pinna)
install=pinna.install
source=("pinna::git+$url.git")
sha256sums=(SKIP)

pkgver() {
    cd pinna
    printf '%s.r%s.g%s' "$(sed -n 's/^version = "\(.*\)"/\1/p' Cargo.toml | head -1)" \
        "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
    cd pinna
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    cd pinna
    export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target
    cargo build --frozen --release
    cmake -S app -B build -G Ninja -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr
    cmake --build build
}

check() {
    cd pinna
    RUSTUP_TOOLCHAIN=stable cargo test --frozen --release
}

package() {
    cd pinna
    install -Dm755 -t "$pkgdir/usr/bin" target/release/pinnad target/release/pinnactl build/pinna
    install -dm755 "$pkgdir/usr/share/bash-completion/completions" "$pkgdir/usr/share/zsh/site-functions" \
        "$pkgdir/usr/share/fish/vendor_completions.d"
    target/release/pinnactl completions bash > "$pkgdir/usr/share/bash-completion/completions/pinnactl"
    target/release/pinnactl completions zsh > "$pkgdir/usr/share/zsh/site-functions/_pinnactl"
    target/release/pinnactl completions fish > "$pkgdir/usr/share/fish/vendor_completions.d/pinnactl.fish"
    install -Dm644 -t "$pkgdir/usr/share/applications" dist/dev.pinna.Pinna.desktop dist/dev.pinna.Popup.desktop
    install -Dm644 dist/dev.pinna.Pinna.metainfo.xml "$pkgdir/usr/share/metainfo/dev.pinna.Pinna.metainfo.xml"
    install -Dm644 NOTICE "$pkgdir/usr/share/licenses/$pkgname/NOTICE"
    install -Dm644 dist/icon.png "$pkgdir/usr/share/icons/hicolor/512x512/apps/dev.pinna.Pinna.png"
    install -Dm644 dist/dev.pinna.Daemon.service "$pkgdir/usr/share/dbus-1/services/dev.pinna.Daemon.service"
    install -dm755 "$pkgdir/usr/lib/systemd/user"
    sed 's|@bindir@|/usr/bin|g' dist/pinnad.service > "$pkgdir/usr/lib/systemd/user/pinnad.service"
}
